{
  "manifest_version": 2,
  "name": "Filter by these senders",
  "version": "1.3",
  "description": "Quick Filter the message list by the senders of all selected messages.",
  "browser_specific_settings": {
    "gecko": {
      "id": "filter-by-senders@maks.top",
      "strict_min_version": "128.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "menus",
    "messagesRead",
    "accountsRead"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  }
}
